{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "App.tsx",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "BE_Mobile_DaNenTang",
    "dist",
    "web-build"
  ]
}
