# Use your computer's LAN IP when running Expo Go on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Required for standalone/dev builds using Google Maps. Restrict this key by
# Android package/SHA-1 and iOS bundle identifier in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_restricted_google_maps_key

